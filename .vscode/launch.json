{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "🚀 Iniciar Servidor GoReview (Node.js)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server.js",
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "🌐 Abrir GoReview no Chrome (localhost:3001)",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
